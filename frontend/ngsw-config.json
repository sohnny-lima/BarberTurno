{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/*.js", "/*.css", "/favicon.ico", "/manifest.webmanifest"]
      }
    },
    {
      "name": "publicos",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": ["/iconos/**", "/fotos/**", "/**/*.woff", "/**/*.woff2"]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api",
    "!/api/**",
    "!/actuator",
    "!/actuator/**",
    "!/.well-known/**",
    "!/v3/**",
    "!/swagger-ui/**"
  ]
}
