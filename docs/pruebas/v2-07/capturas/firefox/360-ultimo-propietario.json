    },
    "seriasOCriticas": 0,
    "total": 0,
    "otras": [],
    "incompletas": [
      {
        "id": "aria-hidden-focus",
        "impacto": "serious",
        "nodos": [
          "app-root",
          ".cdk-focus-trap-anchor.cdk-visually-hidden[aria-hidden=\"true\"]:nth-child(1)",
          ".cdk-focus-trap-anchor.cdk-visually-hidden[aria-hidden=\"true\"]:nth-child(3)"
        ]
      },
      {
        "id": "color-contrast",
        "impacto": "serious",
        "nodos": [
          "p:nth-child(1)",
          ".mensaje"
        ]
      }
    ],
    "contrasteManual": [
      {
        "selector": "p:nth-child(1)",
        "componente": "p.",
