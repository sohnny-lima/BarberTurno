  "viewport": {
    "width": 360,
    "height": 800
  },
  "captura": {
    "width": 360,
    "height": 800
  },
  "superpuesta": true,
  "foco": {
    "etiqueta": "BUTTON",
    "clase": "mdc-button mat-mdc-button-base mat-mdc-button mat-unthemed cdk-focused cdk-keyboard-focused",
    "visible": true,
    "estilo": "solid",
    "ancho": "3px",
    "desfase": "2px"
  },
  "contencion": {
    "ambito": "[role=\"dialog\"]",
