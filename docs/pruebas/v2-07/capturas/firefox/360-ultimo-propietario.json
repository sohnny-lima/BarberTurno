        "minimo": 4.5,
        "exento": false,
        "cumple": true,
        "imagen": false
      },
      {
        "selector": ".mensaje",
        "componente": "p.mensaje",
        "estado": "normal",
        "color": "#7a1f17",
        "fondo": "#fbe6e4",
        "ratio": 8.62,
        "minimo": 4.5,
        "exento": false,
        "cumple": true,
        "imagen": false
      }
    ]
  },
  "disposicion": "sin desbordamiento; escritorio sin barra móvil ni superposición del riel"
}
