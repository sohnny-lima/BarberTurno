# Plantilla sin credenciales reales. No copiar los marcadores a producción.

# Desarrollo y pruebas
# dev/test importan .local/barberturno.env desde backend/ o la raíz (DA-17, T-39).
# Use su contraseña local; el usuario es opcional (barberturno por defecto).
# Omitir BT_DB_URL permite elegir la base correspondiente a cada perfil.
# BT_DB_USER=barberturno
BT_DB_PASSWORD=CAMBIE_POR_SU_CLAVE_LOCAL

# Solo producción
# Configure estas variables en el entorno de producción, nunca en .local/.
# Activarlas en .local/ haría que dev/test usaran secretos de ejemplo y cookies
# Secure, incompatibles con el desarrollo HTTP local. prod no importa el archivo.
# Autenticación y administrador inicial se implementan en T-10.
# JWT: generar al menos 32 bytes aleatorios y codificarlos en Base64.
# BT_JWT_SECRET=CAMBIE_POR_UN_SECRETO_BASE64
# BT_ADMIN_CORREO=admin@ejemplo.test
# BT_ADMIN_PASSWORD=CAMBIE_POR_UNA_CLAVE_SEGURA
# BT_ADMIN_NOMBRE=Administrador de demostración
# BT_COOKIE_SECURE=true
