# Plantilla sin credenciales reales para BarberTurno v2 (V2-01).
# El archivo real, D:\Proyectos\BarberTurno-v2\.local\barberturno.env, lo escribe
# tools/preparar-entorno-v2.ps1. No copie estos marcadores ni reutilice claves de v1 o de producción.
# dev/test lo importan como .properties (DA-17); las variables del sistema tienen prioridad (CI).

# Rol de ejecución: sin propiedad de tablas ni BYPASSRLS (V2-DA-20).
BT_DB_USER=barberturno_v2_app
BT_DB_PASSWORD=GENERADA_POR_EL_SCRIPT

# Rol de migraciones (Flyway), propietario del esquema. La aplicación no lo usa para operar.
BT_FLYWAY_USER=barberturno_v2
BT_FLYWAY_PASSWORD=GENERADA_POR_EL_SCRIPT
